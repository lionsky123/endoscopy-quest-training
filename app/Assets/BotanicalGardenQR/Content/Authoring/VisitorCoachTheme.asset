  _confirmSound: {fileID: 8300000, guid: 1fa66e479047fce43bcde80d570332df, type: 3}
  _guidanceChapter: "\u5730\u56FE\u5F15\u822A"
  _guidanceDepartureCopy: "\u672C\u7AD9\u5B66\u4E60\u5DF2\u5B8C\u6210\u3002\u4E0B\u4E00\u70B9\u4F4D\uFF1A{0}\u3002\u8F7B\u89E6\u51FA\u53D1\u6309\u94AE\uFF0C\u518D\u8DDF\u7740\u6211\u548C\u5730\u9762\u7684\u8DEF\u7EBF\u7EE7\u7EED\u524D\u8FDB\u3002"
  _guidanceDepartureLabel: "\u524D\u5F80\u4E0B\u4E00\u7AD9"
  _guidanceUnavailableCopy: "\u8FD9\u4E00\u6BB5\u6682\u65F6\u65E0\u6CD5\u5E26\u8DEF\u3002\u8BF7\u786E\u8BA4\u624B\u90E8\u4E0E\u5934\u663E\u8FFD\u8E2A\u6B63\u5E38\uFF0C\u518D\u91CD\u65B0\u5F00\u59CB\u3002"
  _guidanceEndLabel: "\u6536\u8D77\u63D0\u793A"
  _presentationPrefab: {fileID: 1649305300181074337, guid: aa8c077921260bb49ab97d6e9d3cb4f9, type: 3}
  _listeningPortrait: {fileID: 21300000, guid: 4b3350511aa8a7243a71ec0c9f870f26, type: 3}
