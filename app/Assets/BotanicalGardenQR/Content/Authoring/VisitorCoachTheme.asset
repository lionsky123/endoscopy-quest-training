  m_Name: VisitorCoachTheme
  m_EditorClassIdentifier: BotanicalGardenQR.Configuration.Runtime::BotanicalGardenQR.Configuration.Runtime.VisitorCoachThemeAsset
  _presentationPrefab: {fileID: 1649305300181074337, guid: aa8c077921260bb49ab97d6e9d3cb4f9, type: 3}
  _listeningPortrait: {fileID: 21300000, guid: 4b3350511aa8a7243a71ec0c9f870f26, type: 3}
