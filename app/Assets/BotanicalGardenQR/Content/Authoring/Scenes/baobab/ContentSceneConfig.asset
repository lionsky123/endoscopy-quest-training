    - rid: 1234463858117836801
      type: {class: ImageRingContentSpec, ns: BotanicalGardenQR.Configuration.Runtime, asm: BotanicalGardenQR.Configuration.Runtime}
      data:
        _items:
        - _image: {fileID: 2800000, guid: f5bc84155af800d4c8785a6259a6a34d, type: 3}
          _audio: {fileID: 8300000, guid: e82477a2f3354e34ba08bdc184258547, type: 3}
          _title: "\u9519\u4E71\u5E03\u5C40\u6848\u4F8B"
          _description: "\u6559\u5B66\u6A21\u62DF\uFF1A\u95E8\u655E\u5F00\u3001\u8BBE\u5907\u5171\u7528\u4E0E\u6D41\u7A0B\u56DE\u6D41\uFF1B\u8BF7\u4E0E\u6B63\u786E\u793A\u610F\u5BF9\u7167\u3002"
        - _image: {fileID: 2800000, guid: e590a3b8f9a3b55478502fe251e0c5d1, type: 3}
          _audio: {fileID: 8300000, guid: 8da261f867609e442b0cb1880397120d, type: 3}
          _title: "\u6B63\u786E\u5E03\u5C40\u793A\u610F"
          _description: "\u6559\u5B66\u793A\u610F\uFF1A\u5B9E\u4F53\u9694\u65AD\u3001\u5206\u7C7B\u5206\u8BBE\u4E0E\u5355\u5411\u6D41\u7A0B\uFF1B\u4E0D\u662F\u73B0\u573A\u5408\u89C4\u8BC1\u660E\u3002"
        - _image: {fileID: 2800000, guid: e09609968569e3841a459007b4614f3b, type: 3}
          _audio: {fileID: 8300000, guid: 79094f911ab40af46a688851bb63a267, type: 3}
          _title: "\u6E05\u6D17\u5DE5\u4F4D\u53C2\u8003"
          _description: "\u89C2\u5BDF\u69FD\u4F4D\u4E0E\u5DE5\u5177\uFF1B\u4EC5\u51ED\u5916\u89C2\u4E0D\u80FD\u786E\u8BA4\u5206\u7C7B\u914D\u7F6E\u6216\u5B8C\u6574\u6D41\u7A0B\u3002"
    - rid: 1234463858117836802
      type: {class: KnowledgeMiniGameContentSpec, ns: BotanicalGardenQR.Configuration.Runtime, asm: BotanicalGardenQR.Configuration.Runtime}
      data:
        _questions:
        - _question: "\u6848\u4F8B 1\uFF1A\u6E05\u6D17\u5BA4\u4E0E\u8BCA\u7597\u5BA4\u4E4B\u95F4\u7684\u95E8\u655E\u5F00\u3002\u600E\u6837\u6062\u590D\u672C\u8BFE\u8981\u6C42\u7684\u9694\u79BB\u72B6\u6001\uFF1F"
          _options:
          - _answerId: answer_0
            _text: "\u4FDD\u7559\u655E\u5F00\uFF0C\u589E\u52A0\u6807\u724C"
          - _answerId: answer_1
            _text: "\u5173\u95ED\u95E8\u5E76\u6838\u5BF9\u5B9E\u4F53\u9694\u65AD"
          - _answerId: answer_2
            _text: "\u6302\u4E00\u5757\u5E18\u5B50\u5373\u53EF"
          _correctAnswerId: answer_1
          _successExplanation: "\u6062\u590D\u540E\uFF1A\u5B9E\u4F53\u9694\u65AD\u5B8C\u6574\uFF0C\u95E8\u5173\u95ED\u3002"
          _retryHint: "\u6807\u724C\u4E0E\u5E18\u5B50\u4E0D\u80FD\u66FF\u4EE3\u5B9E\u4F53\u5206\u9694\u3002\u8FD8\u9700\u8BA9\u95E8\u5904\u4E8E\u5173\u95ED\u72B6\u6001\u3002"
        - _question: "\u6848\u4F8B 2\uFF1A\u6D88\u5316\u3001\u547C\u5438\u5185\u955C\u5171\u7528\u540C\u4E00\u7EC4\u6E05\u6D17\u69FD\u4E0E\u6E05\u6D17\u6D88\u6BD2\u673A\u3002\u600E\u6837\u4FEE\u590D\u914D\u7F6E\uFF1F"
          _options:
          - _answerId: answer_0
            _text: "\u53EA\u8D34\u4E0D\u540C\u989C\u8272\u7684\u6807\u7B7E"
          - _answerId: answer_1
            _text: "\u5148\u540E\u4F7F\u7528\u5C31\u7B97\u5206\u8BBE"
          - _answerId: answer_2
            _text: "\u4E24\u7C7B\u69FD\u7EC4\u4E0E\u673A\u5668\u5206\u522B\u914D\u7F6E"
          _correctAnswerId: answer_2
          _successExplanation: "\u6062\u590D\u540E\uFF1A\u6D88\u5316\u3001\u547C\u5438\u5206\u522B\u4F7F\u7528\u5404\u81EA\u7684\u69FD\u7EC4\u548C\u6E05\u6D17\u6D88\u6BD2\u673A\u3002"
          _retryHint: "\u672C\u8BFE\u8981\u6C42\u6E05\u6D17\u69FD\u548C\u6E05\u6D17\u6D88\u6BD2\u673A\u5747\u5206\u5F00\u914D\u7F6E\uFF0C\u6807\u7B7E\u6216\u9519\u5CF0\u4E0D\u7B49\u4E8E\u8BBE\u5907\u5206\u8BBE\u3002"
        - _question: "\u6848\u4F8B 3\uFF1A\u73B0\u573A\u7F3A\u7EC8\u672B\u6F02\u6D17\u4F4D\uFF0C\u8DEF\u7EBF\u4ECE\u6D88\u6BD2\u540E\u6298\u56DE\u524D\u5E8F\u5DE5\u4F4D\u3002\u600E\u6837\u4FEE\u590D\uFF1F"
          _options:
          - _answerId: answer_0
            _text: "\u8865\u9F50\u4E94\u73AF\u8282\u5E76\u6062\u590D\u5355\u5411\u8854\u63A5"
          - _answerId: answer_1
            _text: "\u4ECE\u6D88\u6BD2\u76F4\u63A5\u8DF3\u5230\u5E72\u71E5"
          - _answerId: answer_2
            _text: "\u53EA\u628A\u5730\u9762\u7BAD\u5934\u53CD\u8FC7\u6765"
          _correctAnswerId: answer_0
          _successExplanation: "\u6062\u590D\u540E\uFF1A\u6E05\u6D17 \u2192 \u6F02\u6D17
            \u2192 \u6D88\u6BD2 \u2192 \u7EC8\u672B\u6F02\u6D17 \u2192 \u5E72\u71E5\uFF0C\u5DE5\u4F4D\u9F50\u5168\u3001\u6D41\u7A0B\u5355\u5411\u3002"
          _retryHint: "\u8981\u540C\u65F6\u4FEE\u590D\u5B9E\u9645\u5DE5\u4F4D\u914D\u7F6E\u548C\u8854\u63A5\u5173\u7CFB\uFF0C\u4E0D\u80FD\u9760\u7BAD\u5934\u63A9\u76D6\u7F3A\u4F4D\u6216\u56DE\u6D41\u3002"
    - rid: 7166929538842624021
