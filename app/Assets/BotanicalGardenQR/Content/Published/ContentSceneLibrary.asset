          _title: "\u9694\u65AD\u4E0E\u95E8 \xB7 \u6B63\u8BEF\u5BF9\u7167"
          _description: "\u5DE6\uFF1A\u9694\u65AD\u5B8C\u6574\u3001\u95E8\u5173\u95ED\u3002\u53F3\uFF1A\u95E8\u655E\u5F00\u3002\u89C2\u5BDF\u95E8\u6846\u4E0E\u95ED\u5408\u72B6\u6001\u3002"
        - _image: {fileID: 2800000, guid: 52a62096546c4d6f91b187e50461c801, type: 3}
          _audio: {fileID: 8300000, guid: 5de32607d8d48d64d968fe2b3a62f5dc, type: 3}
          _title: "\u69FD\u4E0E\u673A\u5668\u5206\u8BBE \xB7 \u6B63\u8BEF\u5BF9\u7167"
          _description: "\u5DE6\uFF1A\u4E24\u7C7B\u69FD\u7EC4\u4E0E\u673A\u5668\u5206\u522B\u914D\u7F6E\u3002\u53F3\uFF1A\u5171\u7528\u4E00\u5957\u8BBE\u5907\u3002\u5206\u8BBE\u4E0D\u80FD\u53EA\u9760\u6807\u7B7E\u3002"
        - _image: {fileID: 2800000, guid: 683e058a06bc4b24bb570da1e1244b90, type: 3}
          _audio: {fileID: 8300000, guid: 01085479eec44774b8a58e8ae13810a0, type: 3}
          _title: "\u5355\u5411\u8854\u63A5 \xB7 \u6B63\u8BEF\u5BF9\u7167"
          _description: "\u5DE6\uFF1A\u6309\u4E94\u73AF\u8282\u7531\u6C61\u5230\u6D01\u3002\u53F3\uFF1A\u5411\u6C61\u67D3\u7AEF\u56DE\u6D41\u3002\u5E72\u71E5\u4E3A\u72EC\u7ACB\u5E72\u71E5\u5DE5\u4F4D\u3002"
    - rid: 1010
      type: {class: KnowledgeMiniGameContentSpec, ns: BotanicalGardenQR.Configuration.Runtime, asm: BotanicalGardenQR.Configuration.Runtime}
      data:
        _questions:
        - _question: "\u89C2\u5BDF\u6E05\u6D17\u6D88\u6BD2\u5BA4\u4E0E\u8BCA\u7597\u5BA4\u7684\u5206\u9694\uFF0C\u672C\u8BFE\u5E94\u91CD\u70B9\u786E\u8BA4\u4EC0\u4E48\uFF1F"
          _options:
          - _answerId: sign
            _text: "\u95E8\u4E0A\u6709\u623F\u95F4\u540D\u79F0\u5373\u53EF"
          - _answerId: partition
            _text: "\u5B9E\u4F53\u9694\u65AD\u5B8C\u6574\uFF0C\u95E8\u5904\u4E8E\u5173\u95ED\u72B6\u6001"
          - _answerId: tidy
            _text: "\u5730\u9762\u6574\u6D01\u5C31\u8BF4\u660E\u5206\u9694\u7B26\u5408\u8981\u6C42"
          _correctAnswerId: partition
          _successExplanation: "\u5E94\u89C2\u5BDF\u5899\u4F53\u4E0E\u95E8\u5F62\u6210\u7684\u5B9E\u4F53\u5206\u9694\uFF0C\u5E76\u786E\u8BA4\u95E8\u7684\u5173\u95ED\u72B6\u6001\u3002\u95E8\u724C\u548C\u6574\u6D01\u7A0B\u5EA6\u4E0D\u80FD\u66FF\u4EE3\u8FD9\u4E24\u9879\u89C2\u5BDF\u3002"
          _retryHint: "\u56DE\u60F3\u95E8\u4E0E\u5899\u4F53\u7684\u7279\u5199\uFF1A\u9700\u8981\u540C\u65F6\u6838\u5BF9\u5B9E\u4F53\u5206\u9694\u548C\u95E8\u7684\u72B6\u6001\u3002"
        - _question: "\u6D88\u5316\u5185\u955C\u4E0E\u547C\u5438\u5185\u955C\u7684\u8BBE\u5907\u5206\u8BBE\uFF0C\u54EA\u9879\u7B26\u5408\u8981\u6C42\uFF1F"
          _options:
          - _answerId: dedicated
            _text: "\u6E05\u6D17\u69FD\u4E0E\u6E05\u6D17\u6D88\u6BD2\u673A\u5747\u5404\u81EA\u914D\u7F6E\u3001\u5206\u5F00\u4F7F\u7528"
          - _answerId: timed
            _text: "\u5171\u7528\u8BBE\u5907\uFF0C\u53EA\u8981\u5206\u65F6\u6BB5\u4F7F\u7528"
          - _answerId: labels
            _text: "\u5728\u5171\u7528\u6E05\u6D17\u69FD\u4E0A\u8D34\u4E24\u79CD\u6807\u7B7E"
          _correctAnswerId: dedicated
          _successExplanation: "WS 507\u20142016 \u7B2C 5.3.5 \u6761\u8981\u6C42\u4E0D\u540C\u7CFB\u7EDF\u8F6F\u5F0F\u5185\u955C\u7684\u6E05\u6D17\u69FD\u3001\u81EA\u52A8\u6E05\u6D17\u6D88\u6BD2\u673A\u5206\u5F00\u8BBE\u7F6E\u548C\u4F7F\u7528\u3002\u4E24\u7C7B\u8BBE\u5907\u90FD\u8981\u6838\u5BF9\u3002"
          _retryHint: "\u5206\u8BBE\u5305\u62EC\u6E05\u6D17\u69FD\u548C\u6E05\u6D17\u6D88\u6BD2\u673A\uFF0C\u4E0D\u662F\u53EA\u5206\u6807\u7B7E\u6216\u64CD\u4F5C\u65F6\u95F4\u3002"
        - _question: "\u6838\u5BF9\u672C\u8BFE\u7684\u5DE5\u4F4D\u4E0E\u6D41\u7A0B\uFF0C\u54EA\u4E00\u9879\u6B63\u786E\uFF1F"
          _options:
          - _answerId: reverse
            _text: "\u5DE5\u4F4D\u591F\u591A\u5C31\u53EF\u4EE5\uFF0C\u6D88\u6BD2\u540E\u4E5F\u53EF\u8FD4\u56DE\u6C61\u67D3\u5DE5\u4F4D"
          - _answerId: skip
            _text: "\u6E05\u6D17\u540E\u76F4\u63A5\u6D88\u6BD2\uFF0C\u518D\u8FDB\u5165\u5E72\u71E5"
          - _answerId: forward
            _text: "\u6E05\u6D17\u2192\u6F02\u6D17\u2192\u6D88\u6BD2\u2192\u7EC8\u672B\u6F02\u6D17\u2192\u5E72\u71E5\uFF0C\u7531\u6C61\u5230\u6D01\u5355\u5411\u8854\u63A5"
          _correctAnswerId: forward
          _successExplanation: "\u672C\u955C\u5934\u91CD\u70B9\u6838\u5BF9\u8FD9\u4E94\u4E2A\u73AF\u8282\u7684\u5DE5\u4F4D\u548C\u5355\u5411\u8854\u63A5\u3002\u5E72\u71E5\u662F\u5E72\u71E5\u5DE5\u4F4D\uFF1B\u5B8C\u6574\u5185\u955C\u5904\u7406\u8FD8\u6D89\u53CA\u672C\u955C\u5934\u4EE5\u5916\u7684\u6B65\u9AA4\u3002"
          _retryHint: "\u540C\u65F6\u68C0\u67E5\u73AF\u8282\u662F\u5426\u9F50\u5168\u3001\u65B9\u5411\u662F\u5426\u7531\u6C61\u5230\u6D01\uFF0C\u4E0D\u80FD\u6F0F\u6389\u7EC8\u672B\u6F02\u6D17\u6216\u8BA9\u6D01\u51C0\u7AEF\u56DE\u6D41\u3002"
