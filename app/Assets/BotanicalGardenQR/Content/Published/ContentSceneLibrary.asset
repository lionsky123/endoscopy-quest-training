            _text: "\u6309\u74F6\u5B50\u989C\u8272\u731C\u4EA7\u54C1"
          - _answerId: answer_1
            _text: "\u7167\u65C1\u8FB9\u53E6\u4E00\u74F6\u8BF4\u660E\u4E66\u4F7F\u7528"
          - _answerId: answer_2
            _text: "\u6838\u5B9E\u4EA7\u54C1\u8EAB\u4EFD\u548C\u5B8C\u6574\u914D\u5957\u8D44\u6599"
          _correctAnswerId: answer_2
          _successExplanation: "\u6062\u590D\u65B9\u6848\uFF1A\u6838\u5B9E\u8BE5\u74F6\u4EA7\u54C1\u8EAB\u4EFD\uFF0C\u53D6\u5F97\u6E05\u6670\u5B8C\u6574\u6807\u7B7E\u53CA\u540C\u4EA7\u54C1\u8BF4\u660E\u4E66\uFF0C\u672A\u786E\u8BA4\u524D\u4E0D\u5224\u4E3A\u9002\u7528\u3002"
          _retryHint: "\u9700\u8981\u5148\u786E\u8BA4\u5B9E\u9645\u4EA7\u54C1\uFF0C\u4E0D\u80FD\u628A\u5176\u4ED6\u4EA7\u54C1\u8BF4\u660E\u4E66\u5F53\u4F5C\u8BE5\u74F6\u7684\u4F9D\u636E\u3002"
        - _question: "\u6848\u4F8B 2\uFF1A\u8BF4\u660E\u4E66\u672A\u786E\u8BA4\u9002\u914D\u8BE5\u5185\u955C\u3002\u600E\u6837\u9009\u62E9\u4FEE\u590D\u65B9\u6848\uFF1F"
          _options:
          - _answerId: answer_0
            _text: "\u6838\u5BF9\u9AD8\u6C34\u5E73\u6D88\u6BD2\u7528\u9014\u548C\u6750\u6599\u9002\u914D"
          - _answerId: answer_1
            _text: "\u6D88\u6BD2\u5242\u8D8A\u5F3A\u8D8A\u597D"
          - _answerId: answer_2
            _text: "\u53EA\u770B\u54C1\u724C\u5C31\u5224\u4E3A\u9002\u7528"
          _correctAnswerId: answer_0
          _successExplanation: "\u6062\u590D\u65B9\u6848\uFF1A\u7ED3\u5408\u6D88\u6BD2\u5242\u4E0E\u5185\u955C\u8BF4\u660E\u4E66\u786E\u8BA4\u9AD8\u6C34\u5E73\u6D88\u6BD2\u7528\u9014\u3001\u6750\u6599\u9002\u914D\u53CA\u4F7F\u7528\u9650\u5236\u3002"
          _retryHint: "\u6D88\u6BD2\u7528\u9014\u548C\u5185\u955C\u6750\u6599\u9002\u914D\u5747\u9700\u6838\u5BF9\uFF0C\u4E0D\u53EF\u4EC5\u51ED\u54C1\u724C\u6216\u5F3A\u5F31\u5224\u65AD\u3002"
        - _question: "\u6848\u4F8B 3\uFF1A\u5BAB\u8154\u955C\u9644\u4EF6\u76D2\u53EA\u8D34\u201C\u5DF2\u706D\u83CC\u201D\uFF0C\u5305\u88C5\u6807\u8BC6\u53CA\u6279\u6B21\u8BC1\u636E\u7F3A\u5931\u3002\u600E\u4E48\u4FEE\u590D\uFF1F"
          _options:
          - _answerId: answer_0
            _text: "\u518D\u8D34\u4E00\u5F20\u201C\u5DF2\u706D\u83CC\u201D"
          - _answerId: answer_1
            _text: "\u6838\u67E5\u5305\u88C5\u6807\u8BC6\u4E0E\u5BF9\u5E94\u706D\u83CC\u8BC1\u636E"
          - _answerId: answer_2
            _text: "\u5916\u89C2\u6574\u6D01\u5C31\u53EF\u4EE5"
          _correctAnswerId: answer_1
          _successExplanation: "\u6062\u590D\u65B9\u6848\uFF1A\u6838\u67E5\u5B8C\u6574\u5305\u88C5\u6807\u8BC6\u4E0E\u5BF9\u5E94\u6279\u6B21\u706D\u83CC\u3001\u653E\u884C\u8BC1\u636E\uFF0C\u7F3A\u5931\u8BC1\u636E\u4FDD\u7559\u5F85\u786E\u8BA4\u3002"
          _retryHint: "\u5355\u72EC\u4E00\u4E2A\u201C\u5DF2\u706D\u83CC\u201D\u6807\u7B7E\u4E0D\u8DB3\u4EE5\u8BC1\u660E\u5BF9\u5E94\u9644\u4EF6\u5DF2\u5B8C\u6210\u89C4\u8303\u706D\u83CC\u5904\u7406\u3002"
        - _question: "\u6848\u4F8B 4\uFF1A\u5F53\u5929\u793A\u4F8B\u6709\u4E09\u6B21\u6D4B\u6F0F\u4F7F\u7528\uFF0C\u5374\u53EA\u6709\u4E00\u6761\u8BB0\u5F55\u3002\u600E\u4E48\u4FEE\u590D\uFF1F"
          _options:
          - _answerId: answer_0
            _text: "\u4E00\u5929\u4E00\u6761\u5C31\u8DB3\u591F"
          - _answerId: answer_1
            _text: "\u590D\u5236\u540C\u4E00\u6761\u8BB0\u5F55\u4E09\u904D"
          - _answerId: answer_2
            _text: "\u9010\u6B21\u6838\u5BF9\u771F\u5B9E\u4F7F\u7528\u4E0E\u5BF9\u5E94\u8BB0\u5F55"
          _correctAnswerId: answer_2
          _successExplanation: "\u6062\u590D\u65B9\u6848\uFF1A\u9010\u6B21\u6838\u5BF9\u4E09\u6B21\u4F7F\u7528\u548C\u771F\u5B9E\u8BB0\u5F55\uFF0C\u660E\u786E\u7F3A\u9879\u5E76\u6309\u5B9E\u9645\u60C5\u51B5\u5904\u7406\uFF1B\u540C\u65F6\u68C0\u67E5\u8BBE\u5907\u5F53\u524D\u72B6\u6001\u3002"
          _retryHint: "\u672C\u8BFE\u8981\u6C42\u6BCF\u6B21\u4F7F\u7528\u5747\u6709\u5BF9\u5E94\u8BB0\u5F55\uFF0C\u4E0D\u80FD\u590D\u5236\u6216\u8865\u9020\u65E0\u6CD5\u6838\u5B9E\u7684\u5185\u5BB9\u3002"
